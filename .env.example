# Amune Expense Tracker - Environment Configuration Template
# Copy this file to .env and paste your own Groq API key:
#   copy .env.example .env

# Database Configuration
DATABASE_URL=sqlite:///./finance.db

# Sliding window for duplicate transaction detection (in seconds)
DUPLICATE_WINDOW_SECONDS=300

# Groq API Configuration (Fast AI Auto-Categorization)
# 1. Obtain a free API key at: https://console.groq.com/keys
# 2. Paste your own key here:
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=3.0

# NOTE FOR REVIEWERS / EVALUATORS:
# If GROQ_API_KEY is left empty or omitted, the application seamlessly runs
# using the built-in hard-coded keyword fallback dictionary for all categories.
# Providing a Groq key enables real-time LLM-based categorization.
